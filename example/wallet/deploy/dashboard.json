      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rpc_server_call_duration_bucket{job=\"wallet\", rpc_method!=\"wallet.v1.Wallet/WatchAccount\"}[$__rate_interval])))",
          "legendFormat": "p50"
