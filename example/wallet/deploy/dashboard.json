    {
      "id": 3,
      "type": "timeseries",
      "title": "Wallet latency of unary calls",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
