{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended"
  ],
  "ignorePaths": [
    "docs/**"
  ],
  "osvVulnerabilityAlerts": true,
  "schedule": [
    "before 4am"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "labels": [
    "renovate"
  ],
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "groupName": "Patch and digest versions",
      "groupSlug": "patch-digest"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Minor versions",
      "groupSlug": "minor"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
