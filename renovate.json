{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "abandonments:recommended"
  ],
  "ignorePaths": [
    "docs/**"
  ],
  "osvVulnerabilityAlerts": true,
  "schedule": [
    "before 4am"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "labels": [
    "renovate"
  ],
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "groupName": "Patch and digest versions",
      "groupSlug": "patch-digest",
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "Minor versions",
      "groupSlug": "minor",
      "automerge": true
    },
    {
      "description": "The minimum Go version in go.mod follows a support schedule, so it is bumped by hand",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "enabled": false
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
