# VSCode
.vscode

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# go build ./... writes a module's executable into the module's directory
# when main is the module's only package, so verifying a change builds this one.
/example/job/hello/hello

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
dist/

# Claude Code local settings
.claude/settings.local.json

# Backlog plugin per-issue worktrees
.claude/worktrees/

# Hugo
docs/public/
docs/resources/_gen/
docs/.hugo_build.lock
docs/package.json
docs/package-lock.json

# Certificates
**/certs/